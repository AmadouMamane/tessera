# Frontend environment — copy to .env.local (gitignored) and fill in.

# Backend agent the server-side proxy talks to, and the service bearer token
# (must match the agent's TESSERA_API__BEARER_TOKEN). Server-only, never NEXT_PUBLIC_.
TESSERA_BACKEND_URL=http://localhost:8099
TESSERA_BACKEND_TOKEN=change-me

# Auth.js (ADR 0009). AUTH_SECRET signs the session JWT — required in production.
# Generate with: openssl rand -base64 33
AUTH_SECRET=change-me

# Demo operator passwords. Optional — fall back to the demo defaults
# (tessera-admin / tessera-auditor) which are displayed in the login UI.
# TESSERA_AUTH_ADMIN_PASSWORD=
# TESSERA_AUTH_AUDITOR_PASSWORD=
